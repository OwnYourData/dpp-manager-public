# Copy this file to `.env` next to docker-compose.yml to change either of these.
# Neither is needed for an ordinary installation.

# Where the encrypted data file is kept. A path on this computer, absolute or
# relative to docker-compose.yml. This folder is the backup.
DPP_MANAGER_DATA=./data

# The address the application is reached at: http://localhost:3000
DPP_MANAGER_PORT=3000
