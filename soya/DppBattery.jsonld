    },
    "transformation": "soya:transformation",
    "OverlayEncoding": "soya:OverlayEncoding",
    "OverlayAlignment": "soya:OverlayAlignment",
    "OverlayAnnotation": "soya:OverlayAnnotation",
    "OverlayValidation": "soya:OverlayValidation",
    "OverlayClassification": "soya:OverlayClassification",
    "OverlayTransformation": "soya:OverlayTransformation",
    "@base": "https://soya.ownyourdata.eu/DppBattery/",
