      "@type": "OverlayAnnotation",
      "onBase": "ProductDocument"
    },
    {
      "@id": "BatteryOverlayValidation",
      "name": "DppBatteryValidationOverlay",
      "@type": "OverlayValidation",
      "onBase": "Battery",
      "sh:property": [
        {
          "sh:path": "batteryIdentifier",
          "sh:message": "Batteriekennung fehlt oder enthält unzulässige Zeichen.",
          "sh:pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 64,
          "sh:minLength": 1
        },
        {
          "sh:path": "manufacturerIdentifier",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 64,
          "sh:minLength": 1
        },
        {
          "sh:path": "manufacturerName",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 120,
          "sh:minLength": 1
        },
        {
          "sh:path": "manufacturingPlace",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 120,
          "sh:minLength": 1
        },
        {
          "sh:path": "manufacturingDate",
          "sh:message": "Herstellungsdatum als JJJJ-MM angeben, zum Beispiel 2026-06.",
          "sh:pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "sh:maxCount": 1,
          "sh:minCount": 1
        },
        {
          "sh:path": "placedInServiceDate",
          "sh:pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "sh:maxCount": 1,
          "sh:minCount": 0
        },
        {
          "sh:path": "warrantyPeriod",
          "sh:pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "sh:maxCount": 1,
          "sh:minCount": 1
        },
        {
          "sh:in": {
            "@list": [
              "EVBattery",
              "LMTBattery",
              "IndustrialBattery",
              "StationaryStorage"
            ]
          },
          "sh:path": "batteryCategory",
          "sh:maxCount": 1,
          "sh:minCount": 1
        },
        {
          "sh:path": "batteryMass",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 10000,
          "sh:minInclusive": 0
        },
        {
          "sh:in": {
            "@list": [
              "Original",
              "Repurposed",
              "Reused",
              "Remanufactured",
              "Waste"
            ]
          },
          "sh:path": "batteryStatus",
          "sh:maxCount": 1,
          "sh:minCount": 1
        },
        {
          "sh:path": "extinguishingAgent",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 200,
          "sh:minLength": 1
        },
        {
          "sh:path": "meaningOfLabels",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxLength": 1000,
          "sh:minLength": 1
        },
        {
          "sh:path": "carbonFootprintTotal",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 10000,
