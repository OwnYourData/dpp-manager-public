        },
        {
          "sh:path": "capacityFade",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 100,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "stateOfCertifiedEnergy",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 100,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "stateOfCharge",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 100,
