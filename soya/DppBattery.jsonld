    {
      "@id": "Battery",
      "label": {
        "de": [
          "Batterie"
        ],
        "en": [
          "Battery"
        ]
      },
      "comment": {
        "de": [
          "Batteriepass-Daten einer Batterie, nach DIN DKE SPEC 99100:2025-02 und Anhang XIII der Verordnung (EU) 2023/1542."
        ],
        "en": [
          "Battery passport data of one battery, following DIN DKE SPEC 99100:2025-02 and Annex XIII of Regulation (EU) 2023/1542."
        ]
      }
    },
    {
      "@id": "batteryIdentifier",
      "label": {
        "de": [
          "Batteriekennung"
        ],
        "en": [
          "Battery identifier"
        ]
      },
      "comment": {
        "de": [
          "Die eindeutige Kennung genau dieser Batterie, so wie sie auf der Batterie und im Datenträger steht."
        ],
        "en": [
          "The unique identifier of this individual battery, exactly as it is carried on the battery and in the data carrier."
        ]
      }
    },
    {
      "@id": "manufacturerIdentifier",
      "label": {
        "de": [
          "Herstellerkennung"
        ],
        "en": [
          "Manufacturer identifier"
        ]
      },
      "comment": {
        "de": [
          "Kennung des Herstellers, zum Beispiel die EU-Registriernummer des Wirtschaftsteilnehmers oder eine GLN."
        ],
        "en": [
          "Identifier of the manufacturer, for example the EU operator registration number or a GLN."
        ]
      }
    },
    {
      "@id": "manufacturerName",
      "label": {
        "de": [
          "Herstellername"
        ],
        "en": [
          "Manufacturer name"
        ]
      },
      "comment": {
        "de": [
          "Firmenbezeichnung des Herstellers, der die Batterie in Verkehr bringt."
        ],
        "en": [
          "Legal name of the manufacturer placing the battery on the market."
        ]
      }
    },
    {
      "@id": "manufacturingPlace",
      "label": {
        "de": [
          "Herstellungsort"
        ],
        "en": [
          "Manufacturing place"
        ]
      },
      "comment": {
        "de": [
          "Ort der Herstellung, als Stadt und Land des Werks, in dem die Batterie gefertigt wurde."
        ],
        "en": [
          "Place of manufacture, as city and country of the plant where the battery was assembled."
        ]
      }
    },
    {
      "@id": "manufacturingDate",
      "label": {
        "de": [
          "Herstellungsdatum"
        ],
        "en": [
          "Manufacturing date"
        ]
      },
      "comment": {
        "de": [
          "Monat der Herstellung als JJJJ-MM, zum Beispiel 2026-06."
        ],
        "en": [
          "Month of manufacture as YYYY-MM, for example 2026-06."
        ]
      }
    },
    {
      "@id": "placedInServiceDate",
      "label": {
        "de": [
          "Datum der Inbetriebnahme"
        ],
        "en": [
          "Date of putting into service"
        ]
      },
      "comment": {
        "de": [
          "Monat der Inbetriebnahme als JJJJ-MM. Leer lassen, solange sie nicht in Betrieb ist."
        ],
        "en": [
          "Month the battery was put into service as YYYY-MM. Leave empty as long as it has not been."
        ]
      }
    },
    {
      "@id": "warrantyPeriod",
      "label": {
        "de": [
          "Garantiezeitraum bis"
        ],
        "en": [
          "Warranty period until"
        ]
      },
      "comment": {
        "de": [
          "Monat, in dem die Garantie der Batterie endet, als JJJJ-MM."
        ],
        "en": [
          "Month the warranty of the battery ends, as YYYY-MM."
        ]
      }
    },
    {
      "@id": "batteryCategory",
      "label": {
        "de": [
          "Batteriekategorie"
        ],
        "en": [
          "Battery category"
        ]
      },
      "comment": {
        "de": [
          "Kategorie nach der Batterieverordnung. Sie entscheidet, welche Attribute verpflichtend sind."
        ],
        "en": [
          "Category under the Batteries Regulation. It decides which attributes are mandatory."
        ]
      }
    },
    {
      "@id": "batteryMass",
      "label": {
        "de": [
          "Batteriemasse (kg)"
        ],
        "en": [
          "Battery mass (kg)"
        ]
      },
      "comment": {
        "de": [
          "Gesamtmasse der Batterie in Kilogramm, einschließlich Gehäuse und Batteriemanagementsystem."
        ],
        "en": [
          "Total mass of the battery in kilograms, including housing and the battery management system."
        ]
      }
    },
    {
      "@id": "batteryStatus",
      "label": {
        "de": [
          "Batteriestatus"
        ],
        "en": [
          "Battery status"
        ]
      },
      "comment": {
        "de": [
          "Aktueller Status im Lebenszyklus. Dieses Attribut ändert sich über die Lebensdauer der Batterie."
        ],
        "en": [
          "Current status in the life cycle. This attribute changes over the life of the battery."
        ]
      }
    },
    {
      "@id": "extinguishingAgent",
      "label": {
        "de": [
          "Löschmittel"
        ],
        "en": [
          "Extinguishing agent"
        ]
      },
      "comment": {
        "de": [
          "Für diese Batteriechemie geeignetes Löschmittel, wie im Sicherheitsdatenblatt angegeben."
        ],
        "en": [
          "Extinguishing agent suitable for this battery chemistry, as stated in the safety data sheet."
        ]
      }
    },
    {
      "@id": "meaningOfLabels",
      "label": {
        "de": [
          "Bedeutung von Kennzeichnungen und Symbolen"
        ],
        "en": [
          "Meaning of labels and symbols"
        ]
      },
      "comment": {
        "de": [
          "Verständliche Erklärung der auf der Batterie angebrachten Symbole, für den Leser des Passes."
        ],
        "en": [
          "Plain explanation of the symbols carried on the battery, for the person reading the passport."
        ]
      }
    },
    {
      "@id": "carbonFootprintTotal",
      "label": {
        "de": [
          "CO2-Fußabdruck (kgCO2e/kWh)"
        ],
        "en": [
          "Carbon footprint (kgCO2e/kWh)"
        ]
      },
      "comment": {
        "de": [
          "Gesamter CO2-Fußabdruck je funktionaler Einheit, also je kWh Gesamtenergie über die Lebensdauer."
        ],
        "en": [
          "Total carbon footprint per functional unit, that is per kWh of total energy over the service life."
        ]
      }
    },
    {
      "@id": "cfRawMaterial",
      "label": {
        "de": [
          "Anteil: Rohstoffgewinnung"
        ],
        "en": [
          "Share: raw material acquisition"
        ]
      },
      "comment": {
        "de": [
          "Beitrag der Rohstoffgewinnung und Vorverarbeitung zum CO2-Fußabdruck."
        ],
        "en": [
          "Contribution of raw material acquisition and pre-processing to the carbon footprint."
        ]
      }
    },
    {
      "@id": "cfProduction",
      "label": {
        "de": [
          "Anteil: Herstellung"
        ],
        "en": [
          "Share: production"
        ]
      },
      "comment": {
        "de": [
          "Beitrag der Haupt-Produktions- und Fertigungsstufe."
        ],
        "en": [
          "Contribution of the main product production and manufacturing stage."
        ]
      }
    },
    {
      "@id": "cfDistribution",
      "label": {
        "de": [
          "Anteil: Distribution"
        ],
        "en": [
          "Share: distribution"
        ]
      },
      "comment": {
        "de": [
          "Beitrag der Distributionsstufe."
        ],
        "en": [
          "Contribution of the distribution stage."
        ]
      }
    },
    {
      "@id": "cfEndOfLife",
      "label": {
        "de": [
          "Anteil: Lebensende und Recycling"
        ],
        "en": [
          "Share: end of life and recycling"
        ]
      },
      "comment": {
        "de": [
          "Beitrag der Stufe Lebensende und Recycling."
        ],
        "en": [
          "Contribution of the end of life and recycling stage."
        ]
      }
    },
    {
      "@id": "carbonFootprintClass",
      "label": {
        "de": [
          "CO2-Fußabdruck-Leistungsklasse"
        ],
        "en": [
          "Carbon footprint performance class"
        ]
      },
      "comment": {
        "de": [
          "Leistungsklasse vom CO2-Fußabdruck-Label."
        ],
        "en": [
          "Performance class from the carbon footprint label."
        ]
      }
    },
    {
      "@id": "carbonFootprintStudyUrl",
      "label": {
        "de": [
          "CO2-Fußabdruck-Studie"
        ],
        "en": [
          "Carbon footprint study"
        ]
      },
      "comment": {
        "de": [
          "Öffentliche https-Adresse der CO2-Fußabdruck-Studie, ohne Anmeldung erreichbar."
        ],
        "en": [
          "Public https address of the carbon footprint study, reachable without login."
        ]
      }
    },
    {
      "@id": "dueDiligenceReportUrl",
      "label": {
        "de": [
          "Sorgfaltspflichtenbericht"
        ],
        "en": [
          "Due diligence report"
        ]
      },
      "comment": {
        "de": [
          "Öffentliche https-Adresse des Berichts über die Lieferkettensorgfalt nach Artikel 52(3) der Batterieverordnung."
        ],
        "en": [
          "Public https address of the supply chain due diligence report under Article 52(3) of the Batteries Regulation."
        ]
      }
    },
    {
      "@id": "thirdPartyAssurance",
      "label": {
        "de": [
          "Bestätigung durch Dritte"
        ],
        "en": [
          "Third-party assurance"
        ]
      },
      "comment": {
        "de": [
          "Anerkanntes System oder Zertifizierung, unter der die Sorgfaltspflichten bestätigt wurden, sofern vorhanden."
        ],
        "en": [
          "Recognised scheme or certification under which the due diligence policy was assured, if any."
        ]
      }
    },
    {
      "@id": "batteryChemistry",
      "label": {
        "de": [
          "Batteriechemie"
        ],
        "en": [
          "Battery chemistry"
        ]
      },
      "comment": {
        "de": [
          "Zellchemie der Batterie. Die Familie auswählen; die genaue Zusammensetzung steht in den Materialfeldern darunter."
        ],
        "en": [
          "Cell chemistry of the battery. Pick the family; the exact composition goes into the material fields below."
        ]
      }
    },
    {
      "@id": "cathodeMaterials",
      "label": {
        "de": [
          "Kathodenmaterialien"
        ],
        "en": [
          "Cathode materials"
        ]
      },
      "comment": {
        "de": [
          "In der Kathode verwendete Materialien, benannt wie in der Stückliste und durch Komma getrennt."
        ],
        "en": [
          "Materials used in the cathode, named as in the bill of materials and separated by commas."
        ]
      }
    },
    {
      "@id": "anodeMaterials",
      "label": {
        "de": [
          "Anodenmaterialien"
        ],
        "en": [
          "Anode materials"
        ]
      },
      "comment": {
        "de": [
          "In der Anode verwendete Materialien, benannt wie in der Stückliste und durch Komma getrennt."
        ],
        "en": [
          "Materials used in the anode, named as in the bill of materials and separated by commas."
        ]
      }
    },
    {
      "@id": "electrolyteMaterials",
      "label": {
        "de": [
          "Elektrolytmaterialien"
        ],
        "en": [
          "Electrolyte materials"
        ]
      },
      "comment": {
        "de": [
