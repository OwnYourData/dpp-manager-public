                "description": "Öffentliche https-Adresse der Information, wie Endnutzer zur Abfallvermeidung beitragen."
              },
              {
                "type": "Control",
                "label": "Getrenntsammlung von Altbatterien",
                "scope": "#/properties/separateCollectionUrl",
                "description": "Öffentliche https-Adresse der Information zur Getrenntsammlung von Altbatterien."
              },
              {
                "type": "Control",
                "label": "Sammlung, zweites Leben und Behandlung",
                "scope": "#/properties/endOfLifeTreatmentUrl",
                "description": "Öffentliche https-Adresse der Information zu Sammlung, Vorbereitung auf ein zweites Leben und Behandlung am Lebensende."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Leistung und Haltbarkeit",
            "elements": [
              {
                "type": "Control",
                "label": "Bemessungskapazität (Ah)",
                "scope": "#/properties/ratedCapacity",
                "description": "Bemessungskapazität in Amperestunden, wie für die neue Batterie deklariert."
              },
              {
                "type": "Control",
                "label": "Verbleibende Kapazität (Ah)",
                "scope": "#/properties/remainingCapacity",
                "description": "Verbleibende Kapazität in Amperestunden. Dieser Wert ändert sich über die Lebensdauer der Batterie."
              },
              {
                "type": "Control",
                "label": "Kapazitätsverlust (%)",
                "scope": "#/properties/capacityFade",
                "description": "Verlust an Kapazität gegenüber der Bemessungskapazität, in Prozent."
              },
              {
                "type": "Control",
                "label": "Zustand der zertifizierten Energie (%)",
                "scope": "#/properties/stateOfCertifiedEnergy",
                "description": "SOCE: verbleibende nutzbare Energie gegenüber der zertifizierten nutzbaren Energie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Ladezustand (%)",
                "scope": "#/properties/stateOfCharge",
                "description": "Ladezustand zum Zeitpunkt der letzten Aktualisierung, in Prozent."
              },
              {
                "type": "Control",
                "label": "Nennspannung (V)",
                "scope": "#/properties/nominalVoltage",
                "description": "Nennspannung des Batteriepacks in Volt."
              },
              {
                "type": "Control",
                "label": "Ursprüngliche Leistungsfähigkeit (W)",
                "scope": "#/properties/originalPowerCapability",
                "description": "Leistungsfähigkeit der neuen Batterie in Watt."
              },
              {
                "type": "Control",
                "label": "Erwartete Lebensdauer (Jahre)",
                "scope": "#/properties/expectedLifetimeYears",
                "description": "Erwartete Lebensdauer in Kalenderjahren unter den Referenzbedingungen."
              },
              {
                "type": "Control",
                "label": "Erwartete Lebensdauer (Lade-Entlade-Zyklen)",
                "scope": "#/properties/expectedLifetimeCycles",
                "description": "Erwartete Anzahl der Lade-Entlade-Zyklen im Referenztest zur Zyklenlebensdauer."
              },
              {
                "type": "Control",
                "label": "Bisherige Vollzyklen",
                "scope": "#/properties/fullCycles",
                "description": "Anzahl der bisher gezählten vollen Lade- und Entladezyklen. Dieser Wert ändert sich über die Lebensdauer der Batterie."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Dokumente",
            "elements": [
              {
                "type": "Control",
                "label": "Dokumente",
                "scope": "#/properties/documents",
                "description": "Zur Batterie gehörende Dokumente, über ihre Webadresse referenziert; es wird nichts hochgeladen. Die EU-Konformitätserklärung und die Prüfberichte gehören hierher."
              }
            ]
          }
        ]
      },
      "@id": "BatteryForm",
      "tag": "dpp",
      "name": "DppBatteryFormOverlayDE",
      "@type": "OverlayForm",
      "onBase": "Battery",
      "schema": {
        "type": "object",
        "required": [
          "batteryIdentifier",
          "manufacturerIdentifier",
          "manufacturerName",
          "manufacturingPlace",
          "manufacturingDate",
          "warrantyPeriod",
          "batteryCategory",
          "batteryMass",
          "batteryStatus",
          "extinguishingAgent",
          "meaningOfLabels",
          "carbonFootprintTotal",
          "cfRawMaterial",
          "cfProduction",
          "cfDistribution",
          "cfEndOfLife",
          "carbonFootprintClass",
          "carbonFootprintStudyUrl",
          "dueDiligenceReportUrl",
          "batteryChemistry",
          "cathodeMaterials",
          "anodeMaterials",
          "electrolyteMaterials",
          "impactOfSubstances",
          "preConsumerNickelShare",
          "preConsumerCobaltShare",
          "preConsumerLithiumShare",
          "preConsumerLeadShare",
          "postConsumerNickelShare",
          "postConsumerCobaltShare",
          "postConsumerLithiumShare",
          "postConsumerLeadShare",
          "renewableContentShare",
          "dismantlingInformationUrl",
          "partNumbersUrl",
          "sparePartsUrl",
          "safetyMeasuresUrl",
          "wastePreventionUrl",
          "separateCollectionUrl",
          "endOfLifeTreatmentUrl",
          "ratedCapacity",
          "remainingCapacity",
          "capacityFade",
          "stateOfCertifiedEnergy",
          "stateOfCharge",
          "nominalVoltage",
          "originalPowerCapability",
          "expectedLifetimeYears",
          "expectedLifetimeCycles",
          "fullCycles"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "contentType"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2}$"
                },
                "contentType": {
                  "type": "string",
                  "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
                },
                "resourceTitle": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                }
              }
            },
            "maxItems": 20
          },
          "fullCycles": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 0
          },
          "batteryMass": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "cfEndOfLife": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "capacityFade": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "cfProduction": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "batteryStatus": {
            "type": "string",
            "oneOf": [
              {
                "const": "Original",
                "title": "Original"
              },
              {
                "const": "Repurposed",
                "title": "Umgewidmet"
              },
              {
                "const": "Reused",
                "title": "Wiederverwendet"
              },
              {
                "const": "Remanufactured",
                "title": "Wiederaufgearbeitet"
              },
              {
                "const": "Waste",
                "title": "Abfall"
              }
            ]
          },
          "cfRawMaterial": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "ratedCapacity": {
            "type": "number",
            "maximum": 100000,
            "minimum": 0
          },
          "sparePartsUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "stateOfCharge": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "anodeMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "cfDistribution": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "nominalVoltage": {
            "type": "number",
            "maximum": 2000,
            "minimum": 0
          },
          "partNumbersUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "warrantyPeriod": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "batteryCategory": {
            "type": "string",
            "oneOf": [
              {
                "const": "EVBattery",
                "title": "Elektrofahrzeugbatterie"
              },
              {
                "const": "LMTBattery",
                "title": "Batterie für leichte Verkehrsmittel"
              },
              {
                "const": "IndustrialBattery",
                "title": "Industriebatterie"
              },
              {
                "const": "StationaryStorage",
                "title": "Stationäres Batteriespeichersystem"
              }
            ]
          },
          "meaningOfLabels": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          },
          "batteryChemistry": {
            "type": "string",
            "oneOf": [
              {
                "const": "NMC",
                "title": "Lithium-Nickel-Mangan-Cobaltoxid (NMC)"
              },
              {
                "const": "NCA",
                "title": "Lithium-Nickel-Cobalt-Aluminiumoxid (NCA)"
              },
              {
                "const": "LFP",
                "title": "Lithium-Eisenphosphat (LFP)"
              },
              {
                "const": "LMO",
                "title": "Lithium-Manganoxid (LMO)"
              },
              {
                "const": "LTO",
                "title": "Lithium-Titanat (LTO)"
              },
              {
                "const": "NaIon",
                "title": "Natrium-Ionen"
              },
              {
                "const": "LeadAcid",
                "title": "Blei-Säure"
              },
              {
                "const": "NiMH",
                "title": "Nickel-Metallhydrid"
              }
            ]
          },
          "cathodeMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "manufacturerName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "batteryIdentifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$",
            "maxLength": 64,
            "minLength": 1
          },
          "manufacturingDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "remainingCapacity": {
            "type": "number",
            "maximum": 100000,
            "minimum": 0
          },
          "safetyMeasuresUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "extinguishingAgent": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "impactOfSubstances": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          },
          "manufacturingPlace": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "wastePreventionUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "hazardousSubstances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "substanceName"
              ],
              "properties": {
                "casNumber": {
                  "type": "string",
                  "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$"
                },
                "substanceName": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "massPercentage": {
                  "type": "number",
                  "maximum": 100,
                  "minimum": 0
                }
              }
            },
            "maxItems": 30
          },
          "placedInServiceDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "thirdPartyAssurance": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "carbonFootprintClass": {
            "type": "string",
            "oneOf": [
              {
                "const": "A",
                "title": "Klasse A"
              },
              {
                "const": "B",
                "title": "Klasse B"
              },
              {
                "const": "C",
                "title": "Klasse C"
              },
              {
                "const": "D",
                "title": "Klasse D"
              },
              {
                "const": "E",
                "title": "Klasse E"
              },
              {
                "const": "F",
                "title": "Klasse F"
              },
              {
                "const": "G",
                "title": "Klasse G"
              }
            ]
          },
          "carbonFootprintTotal": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "criticalRawMaterials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "materialName",
                "massPercentage"
              ],
              "properties": {
                "materialName": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                },
                "massPercentage": {
                  "type": "number",
                  "maximum": 100,
                  "minimum": 0
                }
              }
            },
            "maxItems": 30
          },
          "electrolyteMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "preConsumerLeadShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "dueDiligenceReportUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "endOfLifeTreatmentUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "expectedLifetimeYears": {
            "type": "integer",
            "maximum": 50,
            "minimum": 0
          },
          "postConsumerLeadShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "renewableContentShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "separateCollectionUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "expectedLifetimeCycles": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 0
          },
          "manufacturerIdentifier": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "preConsumerCobaltShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "preConsumerNickelShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "stateOfCertifiedEnergy": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "carbonFootprintStudyUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "originalPowerCapability": {
            "type": "number",
            "maximum": 10000000,
            "minimum": 0
          },
          "postConsumerCobaltShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "postConsumerNickelShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "preConsumerLithiumShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "postConsumerLithiumShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "dismantlingInformationUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "language": "de"
    },
    {
      "ui": {
        "type": "Categorization",
        "options": {
          "density": "compact"
        },
        "elements": [
          {
            "type": "Category",
            "label": "Identification",
            "elements": [
              {
                "type": "Control",
                "label": "Battery identifier",
                "scope": "#/properties/batteryIdentifier",
                "description": "The unique identifier of this individual battery, exactly as it is carried on the battery and in the data carrier."
              },
              {
                "type": "Control",
                "label": "Manufacturer identifier",
                "scope": "#/properties/manufacturerIdentifier",
                "description": "Identifier of the manufacturer, for example the EU operator registration number or a GLN."
              },
              {
                "type": "Control",
                "label": "Manufacturer name",
                "scope": "#/properties/manufacturerName",
                "description": "Legal name of the manufacturer placing the battery on the market."
              },
              {
                "type": "Control",
                "label": "Manufacturing place",
                "scope": "#/properties/manufacturingPlace",
                "description": "Place of manufacture, as city and country of the plant where the battery was assembled."
              },
              {
                "type": "Control",
                "label": "Manufacturing date",
                "scope": "#/properties/manufacturingDate",
                "description": "Month of manufacture as YYYY-MM, for example 2026-06."
              },
              {
                "type": "Control",
                "label": "Date of putting into service",
                "scope": "#/properties/placedInServiceDate",
                "description": "Month the battery was put into service as YYYY-MM. Leave empty as long as it has not been."
              },
              {
                "type": "Control",
                "label": "Warranty period until",
                "scope": "#/properties/warrantyPeriod",
                "description": "Month the warranty of the battery ends, as YYYY-MM."
              },
              {
                "type": "Control",
                "label": "Battery category",
                "scope": "#/properties/batteryCategory",
                "description": "Category under the Batteries Regulation. It decides which attributes are mandatory."
              },
              {
                "type": "Control",
                "label": "Battery mass (kg)",
                "scope": "#/properties/batteryMass",
                "description": "Total mass of the battery in kilograms, including housing and the battery management system."
              },
              {
                "type": "Control",
                "label": "Battery status",
                "scope": "#/properties/batteryStatus",
                "description": "Current status in the life cycle. This attribute changes over the life of the battery."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Conformity and labelling",
            "elements": [
              {
                "type": "Control",
                "label": "Extinguishing agent",
                "scope": "#/properties/extinguishingAgent",
                "description": "Extinguishing agent suitable for this battery chemistry, as stated in the safety data sheet."
              },
              {
                "type": "Control",
                "label": "Meaning of labels and symbols",
                "scope": "#/properties/meaningOfLabels",
                "description": "Plain explanation of the symbols carried on the battery, for the person reading the passport."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Carbon footprint",
            "elements": [
              {
                "type": "Control",
                "label": "Carbon footprint (kgCO2e/kWh)",
                "scope": "#/properties/carbonFootprintTotal",
                "description": "Total carbon footprint per functional unit, that is per kWh of total energy over the service life."
              },
              {
                "type": "Control",
                "label": "Share: raw material acquisition",
                "scope": "#/properties/cfRawMaterial",
                "description": "Contribution of raw material acquisition and pre-processing to the carbon footprint."
              },
              {
                "type": "Control",
                "label": "Share: production",
                "scope": "#/properties/cfProduction",
                "description": "Contribution of the main product production and manufacturing stage."
              },
              {
                "type": "Control",
                "label": "Share: distribution",
                "scope": "#/properties/cfDistribution",
                "description": "Contribution of the distribution stage."
              },
              {
                "type": "Control",
                "label": "Share: end of life and recycling",
                "scope": "#/properties/cfEndOfLife",
                "description": "Contribution of the end of life and recycling stage."
              },
              {
                "type": "Control",
                "label": "Carbon footprint performance class",
                "scope": "#/properties/carbonFootprintClass",
                "description": "Performance class from the carbon footprint label."
              },
              {
                "type": "Control",
                "label": "Carbon footprint study",
                "scope": "#/properties/carbonFootprintStudyUrl",
                "description": "Public https address of the carbon footprint study, reachable without login."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Supply chain due diligence",
            "elements": [
              {
                "type": "Control",
                "label": "Due diligence report",
                "scope": "#/properties/dueDiligenceReportUrl",
                "description": "Public https address of the supply chain due diligence report under Article 52(3) of the Batteries Regulation."
              },
              {
                "type": "Control",
                "label": "Third-party assurance",
                "scope": "#/properties/thirdPartyAssurance",
                "description": "Recognised scheme or certification under which the due diligence policy was assured, if any."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Materials and composition",
            "elements": [
              {
                "type": "Control",
                "label": "Battery chemistry",
                "scope": "#/properties/batteryChemistry",
                "description": "Cell chemistry of the battery. Pick the family; the exact composition goes into the material fields below."
              },
              {
                "type": "Control",
                "label": "Cathode materials",
                "scope": "#/properties/cathodeMaterials",
                "description": "Materials used in the cathode, named as in the bill of materials and separated by commas."
              },
              {
                "type": "Control",
                "label": "Anode materials",
                "scope": "#/properties/anodeMaterials",
                "description": "Materials used in the anode, named as in the bill of materials and separated by commas."
              },
              {
                "type": "Control",
                "label": "Electrolyte materials",
                "scope": "#/properties/electrolyteMaterials",
                "description": "Materials used in the electrolyte, named as in the bill of materials and separated by commas."
              },
              {
                "type": "Control",
                "label": "Impact of substances",
                "scope": "#/properties/impactOfSubstances",
                "description": "Impact of the substances contained on the environment, human health, safety and persons."
              },
              {
                "type": "Control",
                "label": "Critical raw materials",
                "scope": "#/properties/criticalRawMaterials",
                "description": "Critical raw materials contained and their mass share. One row per material."
              },
              {
                "type": "Control",
                "label": "Hazardous substances",
                "scope": "#/properties/hazardousSubstances",
                "description": "Hazardous substances contained beyond mercury, cadmium and lead. One row per substance."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Recycled and renewable content",
            "elements": [
              {
                "type": "Control",
                "label": "Pre-consumer recycled nickel (%)",
                "scope": "#/properties/preConsumerNickelShare",
                "description": "Share of pre-consumer recycled nickel in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Pre-consumer recycled cobalt (%)",
                "scope": "#/properties/preConsumerCobaltShare",
                "description": "Share of pre-consumer recycled cobalt in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Pre-consumer recycled lithium (%)",
                "scope": "#/properties/preConsumerLithiumShare",
                "description": "Share of pre-consumer recycled lithium in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Pre-consumer recycled lead (%)",
                "scope": "#/properties/preConsumerLeadShare",
                "description": "Share of pre-consumer recycled lead in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Post-consumer recycled nickel (%)",
                "scope": "#/properties/postConsumerNickelShare",
                "description": "Share of post-consumer recycled nickel in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Post-consumer recycled cobalt (%)",
                "scope": "#/properties/postConsumerCobaltShare",
                "description": "Share of post-consumer recycled cobalt in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Post-consumer recycled lithium (%)",
                "scope": "#/properties/postConsumerLithiumShare",
                "description": "Share of post-consumer recycled lithium in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Post-consumer recycled lead (%)",
                "scope": "#/properties/postConsumerLeadShare",
                "description": "Share of post-consumer recycled lead in the battery, in percent."
              },
              {
                "type": "Control",
                "label": "Renewable content (%)",
                "scope": "#/properties/renewableContentShare",
                "description": "Share of renewable material content in the battery, in percent."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Circularity",
            "elements": [
              {
                "type": "Control",
                "label": "Dismantling information",
                "scope": "#/properties/dismantlingInformationUrl",
                "description": "Manuals for removing and disassembling the battery pack, as a public https address."
              },
              {
                "type": "Control",
                "label": "Part numbers for components",
                "scope": "#/properties/partNumbersUrl",
                "description": "Public https address of the list of part numbers for the components."
              },
              {
                "type": "Control",
                "label": "Sources of spare parts",
                "scope": "#/properties/sparePartsUrl",
                "description": "Public https address of the information on where spare parts can be obtained."
              },
              {
                "type": "Control",
                "label": "Safety measures",
                "scope": "#/properties/safetyMeasuresUrl",
                "description": "Public https address of the safety measures for handling, storing and transporting the battery."
              }
            ]
          },
          {
            "type": "Category",
            "label": "End of life",
            "elements": [
              {
                "type": "Control",
                "label": "Role of end-users in waste prevention",
                "scope": "#/properties/wastePreventionUrl",
                "description": "Public https address of the information on how end-users contribute to waste prevention."
              },
              {
                "type": "Control",
                "label": "Separate collection of waste batteries",
                "scope": "#/properties/separateCollectionUrl",
                "description": "Public https address of the information on the separate collection of waste batteries."
              },
              {
                "type": "Control",
                "label": "Collection, second life and treatment",
                "scope": "#/properties/endOfLifeTreatmentUrl",
                "description": "Public https address of the information on collection, preparation for second life and treatment at end of life."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Performance and durability",
            "elements": [
              {
                "type": "Control",
                "label": "Rated capacity (Ah)",
                "scope": "#/properties/ratedCapacity",
                "description": "Rated capacity in ampere-hours, as declared for the new battery."
              },
              {
                "type": "Control",
                "label": "Remaining capacity (Ah)",
                "scope": "#/properties/remainingCapacity",
                "description": "Remaining capacity in ampere-hours. This value changes over the life of the battery."
              },
              {
                "type": "Control",
                "label": "Capacity fade (%)",
                "scope": "#/properties/capacityFade",
                "description": "Loss of capacity against the rated capacity, in percent."
              },
              {
                "type": "Control",
                "label": "State of certified energy (%)",
                "scope": "#/properties/stateOfCertifiedEnergy",
                "description": "SOCE: remaining usable energy against the certified usable energy, in percent."
              },
              {
                "type": "Control",
                "label": "State of charge (%)",
                "scope": "#/properties/stateOfCharge",
                "description": "SoC at the time of the last update, in percent."
              },
              {
                "type": "Control",
                "label": "Nominal voltage (V)",
                "scope": "#/properties/nominalVoltage",
                "description": "Nominal voltage of the battery pack in volts."
              },
              {
                "type": "Control",
                "label": "Original power capability (W)",
                "scope": "#/properties/originalPowerCapability",
                "description": "Power capability of the new battery in watts."
              },
              {
                "type": "Control",
                "label": "Expected lifetime (years)",
                "scope": "#/properties/expectedLifetimeYears",
                "description": "Expected lifetime in calendar years under the reference conditions."
              },
              {
                "type": "Control",
                "label": "Expected lifetime (charge-discharge cycles)",
                "scope": "#/properties/expectedLifetimeCycles",
                "description": "Expected number of charge-discharge cycles in the cycle-life reference test."
              },
              {
                "type": "Control",
                "label": "Full cycles so far",
                "scope": "#/properties/fullCycles",
                "description": "Number of full charging and discharging cycles counted so far. This value changes over the life of the battery."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Documents",
            "elements": [
              {
                "type": "Control",
                "label": "Documents",
                "scope": "#/properties/documents",
                "description": "Documents belonging to the battery, referenced by web address; nothing is uploaded. The EU declaration of conformity and the test reports belong here."
              }
            ]
          }
        ]
      },
      "@id": "BatteryForm",
      "tag": "dpp",
      "name": "DppBatteryFormOverlayEN",
      "@type": "OverlayForm",
      "onBase": "Battery",
      "schema": {
        "type": "object",
        "required": [
          "batteryIdentifier",
          "manufacturerIdentifier",
          "manufacturerName",
          "manufacturingPlace",
          "manufacturingDate",
          "warrantyPeriod",
          "batteryCategory",
          "batteryMass",
          "batteryStatus",
          "extinguishingAgent",
          "meaningOfLabels",
          "carbonFootprintTotal",
          "cfRawMaterial",
          "cfProduction",
          "cfDistribution",
          "cfEndOfLife",
          "carbonFootprintClass",
          "carbonFootprintStudyUrl",
          "dueDiligenceReportUrl",
          "batteryChemistry",
          "cathodeMaterials",
          "anodeMaterials",
          "electrolyteMaterials",
          "impactOfSubstances",
          "preConsumerNickelShare",
          "preConsumerCobaltShare",
          "preConsumerLithiumShare",
          "preConsumerLeadShare",
          "postConsumerNickelShare",
          "postConsumerCobaltShare",
          "postConsumerLithiumShare",
          "postConsumerLeadShare",
          "renewableContentShare",
          "dismantlingInformationUrl",
          "partNumbersUrl",
          "sparePartsUrl",
          "safetyMeasuresUrl",
          "wastePreventionUrl",
          "separateCollectionUrl",
          "endOfLifeTreatmentUrl",
          "ratedCapacity",
          "remainingCapacity",
          "capacityFade",
          "stateOfCertifiedEnergy",
          "stateOfCharge",
          "nominalVoltage",
          "originalPowerCapability",
          "expectedLifetimeYears",
          "expectedLifetimeCycles",
          "fullCycles"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "contentType"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2}$"
                },
                "contentType": {
                  "type": "string",
                  "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
                },
                "resourceTitle": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                }
              }
            },
            "maxItems": 20
          },
          "fullCycles": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 0
          },
          "batteryMass": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "cfEndOfLife": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "capacityFade": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "cfProduction": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "batteryStatus": {
            "type": "string",
            "oneOf": [
              {
                "const": "Original",
                "title": "Original"
              },
              {
                "const": "Repurposed",
                "title": "Repurposed"
              },
              {
                "const": "Reused",
                "title": "Reused"
              },
              {
                "const": "Remanufactured",
                "title": "Remanufactured"
              },
              {
                "const": "Waste",
                "title": "Waste"
              }
            ]
          },
          "cfRawMaterial": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "ratedCapacity": {
            "type": "number",
            "maximum": 100000,
            "minimum": 0
          },
          "sparePartsUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "stateOfCharge": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "anodeMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "cfDistribution": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "nominalVoltage": {
            "type": "number",
            "maximum": 2000,
            "minimum": 0
          },
          "partNumbersUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "warrantyPeriod": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "batteryCategory": {
            "type": "string",
            "oneOf": [
              {
                "const": "EVBattery",
                "title": "Electric vehicle battery"
              },
              {
                "const": "LMTBattery",
                "title": "Light means of transport battery"
              },
              {
                "const": "IndustrialBattery",
                "title": "Industrial battery"
              },
              {
                "const": "StationaryStorage",
                "title": "Stationary battery energy storage system"
              }
            ]
          },
          "meaningOfLabels": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          },
          "batteryChemistry": {
            "type": "string",
            "oneOf": [
              {
                "const": "NMC",
                "title": "Lithium nickel manganese cobalt oxide (NMC)"
              },
              {
                "const": "NCA",
                "title": "Lithium nickel cobalt aluminium oxide (NCA)"
              },
              {
                "const": "LFP",
                "title": "Lithium iron phosphate (LFP)"
              },
              {
                "const": "LMO",
                "title": "Lithium manganese oxide (LMO)"
              },
              {
                "const": "LTO",
                "title": "Lithium titanate (LTO)"
              },
              {
                "const": "NaIon",
                "title": "Sodium-ion"
              },
              {
                "const": "LeadAcid",
                "title": "Lead-acid"
              },
              {
                "const": "NiMH",
                "title": "Nickel-metal hydride"
              }
            ]
          },
          "cathodeMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "manufacturerName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "batteryIdentifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$",
            "maxLength": 64,
            "minLength": 1
          },
          "manufacturingDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "remainingCapacity": {
            "type": "number",
            "maximum": 100000,
            "minimum": 0
          },
          "safetyMeasuresUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "extinguishingAgent": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "impactOfSubstances": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          },
          "manufacturingPlace": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "wastePreventionUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "hazardousSubstances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "substanceName"
              ],
              "properties": {
                "casNumber": {
                  "type": "string",
                  "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$"
                },
                "substanceName": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "massPercentage": {
                  "type": "number",
                  "maximum": 100,
                  "minimum": 0
                }
              }
            },
            "maxItems": 30
          },
          "placedInServiceDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "thirdPartyAssurance": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "carbonFootprintClass": {
            "type": "string",
            "oneOf": [
              {
                "const": "A",
                "title": "Class A"
              },
              {
                "const": "B",
                "title": "Class B"
              },
              {
                "const": "C",
                "title": "Class C"
              },
              {
                "const": "D",
                "title": "Class D"
              },
              {
                "const": "E",
                "title": "Class E"
              },
              {
                "const": "F",
                "title": "Class F"
              },
              {
                "const": "G",
                "title": "Class G"
              }
            ]
          },
          "carbonFootprintTotal": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0
          },
          "criticalRawMaterials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "materialName",
                "massPercentage"
              ],
              "properties": {
                "materialName": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                },
                "massPercentage": {
                  "type": "number",
                  "maximum": 100,
                  "minimum": 0
                }
              }
            },
            "maxItems": 30
          },
          "electrolyteMaterials": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "preConsumerLeadShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "dueDiligenceReportUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "endOfLifeTreatmentUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "expectedLifetimeYears": {
            "type": "integer",
            "maximum": 50,
            "minimum": 0
          },
          "postConsumerLeadShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "renewableContentShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "separateCollectionUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "expectedLifetimeCycles": {
            "type": "integer",
            "maximum": 100000,
            "minimum": 0
          },
          "manufacturerIdentifier": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "preConsumerCobaltShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "preConsumerNickelShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "stateOfCertifiedEnergy": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "carbonFootprintStudyUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "originalPowerCapability": {
            "type": "number",
            "maximum": 10000000,
            "minimum": 0
          },
          "postConsumerCobaltShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "postConsumerNickelShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "preConsumerLithiumShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "postConsumerLithiumShare": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "dismantlingInformationUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "language": "en"
    }
  ],
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "dct": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
