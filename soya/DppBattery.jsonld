        },
        {
          "sh:path": "nominalVoltage",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 2000,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "originalPowerCapability",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 10000000,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "expectedLifetimeYears",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 50,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "expectedLifetimeCycles",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 100000,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "fullCycles",
          "sh:maxCount": 1,
          "sh:minCount": 1,
          "sh:maxInclusive": 100000,
          "sh:minInclusive": 0
        },
        {
          "sh:path": "criticalRawMaterials",
          "sh:maxCount": 30,
          "sh:minCount": 0,
          "sh:property": [
            {
              "@type": "sh:PropertyShape",
              "sh:node": {
                "@type": "sh:NodeShape",
                "sh:property": [
                  {
                    "sh:path": "materialName",
                    "sh:maxCount": 1,
                    "sh:minCount": 1,
                    "sh:maxLength": 64,
                    "sh:minLength": 1
                  },
                  {
                    "sh:path": "massPercentage",
                    "sh:maxCount": 1,
                    "sh:minCount": 1,
                    "sh:maxInclusive": 100,
                    "sh:minInclusive": 0
                  }
                ]
              },
              "sh:path": {
                "@list": [
                  {
                    "sh:zeroOrMorePath": {
                      "@id": "rdf:rest"
                    }
                  },
                  {
                    "@id": "rdf:first"
                  }
                ]
              }
            }
          ]
        },
        {
          "sh:path": "hazardousSubstances",
          "sh:maxCount": 30,
          "sh:minCount": 0,
          "sh:property": [
            {
              "@type": "sh:PropertyShape",
              "sh:node": {
                "@type": "sh:NodeShape",
                "sh:property": [
                  {
                    "sh:path": "substanceName",
                    "sh:maxCount": 1,
                    "sh:minCount": 1,
                    "sh:maxLength": 120,
                    "sh:minLength": 1
                  },
                  {
                    "sh:path": "casNumber",
                    "sh:message": "CAS-Nummer im Format 7439-92-1 angeben.",
                    "sh:pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$",
                    "sh:maxCount": 1,
                    "sh:minCount": 0
                  },
                  {
                    "sh:path": "massPercentage",
                    "sh:maxCount": 1,
                    "sh:minCount": 0,
                    "sh:maxInclusive": 100,
                    "sh:minInclusive": 0
                  }
                ]
              },
              "sh:path": {
                "@list": [
                  {
                    "sh:zeroOrMorePath": {
                      "@id": "rdf:rest"
                    }
                  },
                  {
                    "@id": "rdf:first"
                  }
                ]
              }
            }
          ]
        },
        {
          "sh:path": "documents",
          "sh:maxCount": 20,
          "sh:minCount": 0,
          "sh:property": [
            {
              "@type": "sh:PropertyShape",
              "sh:node": {
                "@type": "sh:NodeShape",
                "sh:property": [
                  {
                    "sh:path": "url",
                    "sh:message": "Jedes Dokument braucht eine https-Adresse.",
                    "sh:pattern": "^https://",
                    "sh:maxCount": 1,
                    "sh:minCount": 1
                  },
                  {
                    "sh:path": "contentType",
                    "sh:pattern": "^[a-z]+/[A-Za-z0-9.+-]+$",
                    "sh:maxCount": 1,
                    "sh:minCount": 1
                  },
                  {
                    "sh:path": "resourceTitle",
                    "sh:maxCount": 1,
                    "sh:minCount": 0,
                    "sh:maxLength": 120,
                    "sh:minLength": 1
                  },
                  {
                    "sh:path": "language",
                    "sh:pattern": "^[a-z]{2}$",
                    "sh:maxCount": 1,
                    "sh:minCount": 0
                  }
                ]
              },
              "sh:path": {
                "@list": [
                  {
                    "sh:zeroOrMorePath": {
                      "@id": "rdf:rest"
                    }
                  },
                  {
                    "@id": "rdf:first"
                  }
                ]
              }
            }
          ]
        }
      ],
      "sh:targetClass": "Battery"
    },
    {
      "ui": {
        "type": "Categorization",
        "options": {
          "density": "compact"
        },
        "elements": [
          {
            "type": "Category",
            "label": "Identifikation",
            "elements": [
              {
                "type": "Control",
                "label": "Batteriekennung",
                "scope": "#/properties/batteryIdentifier",
                "description": "Die eindeutige Kennung genau dieser Batterie, so wie sie auf der Batterie und im Datenträger steht."
              },
              {
                "type": "Control",
                "label": "Herstellerkennung",
                "scope": "#/properties/manufacturerIdentifier",
                "description": "Kennung des Herstellers, zum Beispiel die EU-Registriernummer des Wirtschaftsteilnehmers oder eine GLN."
              },
              {
                "type": "Control",
                "label": "Herstellername",
                "scope": "#/properties/manufacturerName",
                "description": "Firmenbezeichnung des Herstellers, der die Batterie in Verkehr bringt."
              },
              {
                "type": "Control",
                "label": "Herstellungsort",
                "scope": "#/properties/manufacturingPlace",
                "description": "Ort der Herstellung, als Stadt und Land des Werks, in dem die Batterie gefertigt wurde."
              },
              {
                "type": "Control",
                "label": "Herstellungsdatum",
                "scope": "#/properties/manufacturingDate",
                "description": "Monat der Herstellung als JJJJ-MM, zum Beispiel 2026-06."
              },
              {
                "type": "Control",
                "label": "Datum der Inbetriebnahme",
                "scope": "#/properties/placedInServiceDate",
                "description": "Monat der Inbetriebnahme als JJJJ-MM. Leer lassen, solange sie nicht in Betrieb ist."
              },
              {
                "type": "Control",
                "label": "Garantiezeitraum bis",
                "scope": "#/properties/warrantyPeriod",
                "description": "Monat, in dem die Garantie der Batterie endet, als JJJJ-MM."
              },
              {
                "type": "Control",
                "label": "Batteriekategorie",
                "scope": "#/properties/batteryCategory",
                "description": "Kategorie nach der Batterieverordnung. Sie entscheidet, welche Attribute verpflichtend sind."
              },
              {
                "type": "Control",
                "label": "Batteriemasse (kg)",
                "scope": "#/properties/batteryMass",
                "description": "Gesamtmasse der Batterie in Kilogramm, einschließlich Gehäuse und Batteriemanagementsystem."
              },
              {
                "type": "Control",
                "label": "Batteriestatus",
                "scope": "#/properties/batteryStatus",
                "description": "Aktueller Status im Lebenszyklus. Dieses Attribut ändert sich über die Lebensdauer der Batterie."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Konformität und Kennzeichnung",
            "elements": [
              {
                "type": "Control",
                "label": "Löschmittel",
                "scope": "#/properties/extinguishingAgent",
                "description": "Für diese Batteriechemie geeignetes Löschmittel, wie im Sicherheitsdatenblatt angegeben."
              },
              {
                "type": "Control",
                "label": "Bedeutung von Kennzeichnungen und Symbolen",
                "scope": "#/properties/meaningOfLabels",
                "description": "Verständliche Erklärung der auf der Batterie angebrachten Symbole, für den Leser des Passes."
              }
            ]
          },
          {
            "type": "Category",
            "label": "CO2-Fußabdruck",
            "elements": [
              {
                "type": "Control",
                "label": "CO2-Fußabdruck (kgCO2e/kWh)",
                "scope": "#/properties/carbonFootprintTotal",
                "description": "Gesamter CO2-Fußabdruck je funktionaler Einheit, also je kWh Gesamtenergie über die Lebensdauer."
              },
              {
                "type": "Control",
                "label": "Anteil: Rohstoffgewinnung",
                "scope": "#/properties/cfRawMaterial",
                "description": "Beitrag der Rohstoffgewinnung und Vorverarbeitung zum CO2-Fußabdruck."
              },
              {
                "type": "Control",
                "label": "Anteil: Herstellung",
                "scope": "#/properties/cfProduction",
                "description": "Beitrag der Haupt-Produktions- und Fertigungsstufe."
              },
              {
                "type": "Control",
                "label": "Anteil: Distribution",
                "scope": "#/properties/cfDistribution",
                "description": "Beitrag der Distributionsstufe."
              },
              {
                "type": "Control",
                "label": "Anteil: Lebensende und Recycling",
                "scope": "#/properties/cfEndOfLife",
                "description": "Beitrag der Stufe Lebensende und Recycling."
              },
              {
                "type": "Control",
                "label": "CO2-Fußabdruck-Leistungsklasse",
                "scope": "#/properties/carbonFootprintClass",
                "description": "Leistungsklasse vom CO2-Fußabdruck-Label."
              },
              {
                "type": "Control",
                "label": "CO2-Fußabdruck-Studie",
                "scope": "#/properties/carbonFootprintStudyUrl",
                "description": "Öffentliche https-Adresse der CO2-Fußabdruck-Studie, ohne Anmeldung erreichbar."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Lieferkettensorgfalt",
            "elements": [
              {
                "type": "Control",
                "label": "Sorgfaltspflichtenbericht",
                "scope": "#/properties/dueDiligenceReportUrl",
                "description": "Öffentliche https-Adresse des Berichts über die Lieferkettensorgfalt nach Artikel 52(3) der Batterieverordnung."
              },
              {
                "type": "Control",
                "label": "Bestätigung durch Dritte",
                "scope": "#/properties/thirdPartyAssurance",
                "description": "Anerkanntes System oder Zertifizierung, unter der die Sorgfaltspflichten bestätigt wurden, sofern vorhanden."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Materialien und Zusammensetzung",
            "elements": [
              {
                "type": "Control",
                "label": "Batteriechemie",
                "scope": "#/properties/batteryChemistry",
                "description": "Zellchemie der Batterie. Die Familie auswählen; die genaue Zusammensetzung steht in den Materialfeldern darunter."
              },
              {
                "type": "Control",
                "label": "Kathodenmaterialien",
                "scope": "#/properties/cathodeMaterials",
                "description": "In der Kathode verwendete Materialien, benannt wie in der Stückliste und durch Komma getrennt."
              },
              {
                "type": "Control",
                "label": "Anodenmaterialien",
                "scope": "#/properties/anodeMaterials",
                "description": "In der Anode verwendete Materialien, benannt wie in der Stückliste und durch Komma getrennt."
              },
              {
                "type": "Control",
                "label": "Elektrolytmaterialien",
                "scope": "#/properties/electrolyteMaterials",
                "description": "Im Elektrolyt verwendete Materialien, benannt wie in der Stückliste und durch Komma getrennt."
              },
              {
                "type": "Control",
                "label": "Wirkung der Stoffe",
                "scope": "#/properties/impactOfSubstances",
                "description": "Wirkung der enthaltenen Stoffe auf Umwelt, menschliche Gesundheit, Sicherheit und Personen."
              },
              {
                "type": "Control",
                "label": "Kritische Rohstoffe",
                "scope": "#/properties/criticalRawMaterials",
                "description": "Enthaltene kritische Rohstoffe und ihr Masseanteil. Je Rohstoff eine Zeile."
              },
              {
                "type": "Control",
                "label": "Gefahrstoffe",
                "scope": "#/properties/hazardousSubstances",
                "description": "Enthaltene Gefahrstoffe über Quecksilber, Cadmium und Blei hinaus. Je Stoff eine Zeile."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Rezyklat- und erneuerbarer Anteil",
            "elements": [
              {
                "type": "Control",
                "label": "Vorverbraucher-Rezyklat Nickel (%)",
                "scope": "#/properties/preConsumerNickelShare",
                "description": "Anteil an vorverbrauchsseitigem Nickel-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Vorverbraucher-Rezyklat Cobalt (%)",
                "scope": "#/properties/preConsumerCobaltShare",
                "description": "Anteil an vorverbrauchsseitigem Cobalt-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Vorverbraucher-Rezyklat Lithium (%)",
                "scope": "#/properties/preConsumerLithiumShare",
                "description": "Anteil an vorverbrauchsseitigem Lithium-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Vorverbraucher-Rezyklat Blei (%)",
                "scope": "#/properties/preConsumerLeadShare",
                "description": "Anteil an vorverbrauchsseitigem Blei-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Nachverbraucher-Rezyklat Nickel (%)",
                "scope": "#/properties/postConsumerNickelShare",
                "description": "Anteil an nachverbrauchsseitigem Nickel-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Nachverbraucher-Rezyklat Cobalt (%)",
                "scope": "#/properties/postConsumerCobaltShare",
                "description": "Anteil an nachverbrauchsseitigem Cobalt-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Nachverbraucher-Rezyklat Lithium (%)",
                "scope": "#/properties/postConsumerLithiumShare",
                "description": "Anteil an nachverbrauchsseitigem Lithium-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Nachverbraucher-Rezyklat Blei (%)",
                "scope": "#/properties/postConsumerLeadShare",
                "description": "Anteil an nachverbrauchsseitigem Blei-Rezyklat in der Batterie, in Prozent."
              },
              {
                "type": "Control",
                "label": "Erneuerbarer Anteil (%)",
                "scope": "#/properties/renewableContentShare",
                "description": "Anteil an erneuerbaren Materialien in der Batterie, in Prozent."
              }
            ]
          },
          {
            "type": "Category",
            "label": "Kreislauffähigkeit",
            "elements": [
              {
                "type": "Control",
                "label": "Demontageinformationen",
