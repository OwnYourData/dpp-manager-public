    },
    "encoding": "soya:encoding",
    "alignment": "soya:alignment",
    "annotation": "soya:annotation",
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "validation": "soya:validation",
    "OverlayForm": "soya:OverlayForm",
    "sh:nodeKind": {
      "@type": "@id"
    },
    "OverlayFormat": "soya:OverlayFormat",
    "subPropertyOf": {
      "@id": "rdfs:subPropertyOf",
