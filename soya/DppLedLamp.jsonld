{
  "@graph": [
    {
      "@id": "DppLedLamp",
      "@type": "owl:Class",
      "subClassOf": "soya:Base"
    },
    {
      "@id": "manufacturerName",
      "@type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "domain": "DppLedLamp"
    },
    {
      "@id": "productDesignation",
      "@type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "domain": "DppLedLamp"
    },
    {
