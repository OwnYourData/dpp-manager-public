                  },
                  {
                    "type": "Control",
                    "label": "Seriennummer",
                    "scope": "#/properties/serialNumber"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Herstelldatum",
                    "scope": "#/properties/dateOfManufacture"
                  },
                  {
                    "type": "Control",
                    "label": "Ursprungsland",
                    "scope": "#/properties/countryOfOrigin"
                  }
                ]
              }
            ]
          },
          {
            "type": "Category",
            "label": "Licht und Leistung",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Nutzlichtstrom (lm)",
                    "scope": "#/properties/usefulLuminousFlux"
                  },
                  {
                    "type": "Control",
                    "label": "Farbtemperatur (K)",
                    "scope": "#/properties/colourTemperature"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Leistungsaufnahme im Ein-Zustand (W)",
                    "scope": "#/properties/onModePower"
                  },
                  {
                    "type": "Control",
                    "label": "Leistungsaufnahme im Bereitschaftszustand (W)",
                    "scope": "#/properties/standbyPower"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Farbwiedergabeindex (Ra)",
                    "scope": "#/properties/colourRenderingIndex"
                  },
                  {
                    "type": "Control",
                    "label": "Abstrahlwinkel (°)",
                    "scope": "#/properties/beamAngle"
                  }
                ]
              },
              {
                "type": "Control",
                "label": "Dimmbarkeit",
                "scope": "#/properties/typeOfDimming"
              }
            ]
          },
          {
            "type": "Category",
            "label": "Lebensdauer",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Bemessungslebensdauer (h)",
                    "scope": "#/properties/ratedLifetime"
                  },
                  {
                    "type": "Control",
                    "label": "Garantierte Schaltzyklen",
                    "scope": "#/properties/guaranteedSwitchingCycles"
                  }
                ]
              },
              {
                "type": "Control",
                "label": "Garantie (Jahre)",
                "scope": "#/properties/warrantyPeriodYears"
              }
            ]
          },
          {
            "type": "Category",
            "label": "Konformität und Stoffe",
            "elements": [
              {
                "type": "Control",
                "label": "CE-Kennzeichnung",
                "scope": "#/properties/ceMarking"
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "RoHS-konform",
                    "scope": "#/properties/rohsCompliant"
                  },
                  {
                    "type": "Control",
                    "label": "Enthält besonders besorgniserregende Stoffe",
                    "scope": "#/properties/containsSvhc"
                  }
                ]
              },
              {
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/containsSvhc",
                    "schema": {
                      "const": true
                    }
                  }
                },
                "type": "Control",
                "label": "Welche Stoffe",
                "scope": "#/properties/svhcSubstances"
              },
              {
                "type": "Control",
                "label": "Konformitätserklärung (Link)",
                "scope": "#/properties/declarationOfConformity"
              }
            ]
          },
          {
            "type": "Category",
            "label": "Umwelt",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Energieeffizienzklasse",
                    "scope": "#/properties/energyEfficiencyClass"
                  },
                  {
                    "type": "Control",
                    "label": "CO2-Fußabdruck (kg CO2e)",
                    "scope": "#/properties/carbonFootprint"
                  }
                ]
              },
              {
                "type": "Control",
                "label": "Demontageanleitung (Link)",
                "scope": "#/properties/dismantlingInstructions"
              }
            ]
          }
        ]
      },
