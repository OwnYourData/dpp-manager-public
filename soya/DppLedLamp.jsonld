    {
      "ui": {
        "type": "Categorization",
        "options": {
          "density": "compact",
          "variant": "standard"
        },
        "elements": [
          {
            "type": "Category",
            "label": "Produkt",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Hersteller",
                    "scope": "#/properties/manufacturerName"
                  },
                  {
                    "type": "Control",
                    "label": "Produktbezeichnung",
                    "scope": "#/properties/productDesignation"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "label": "Modell",
