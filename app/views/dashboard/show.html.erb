<h1><%= t("dashboard.title") %></h1>

<%= render "shared/help", key: "dashboard.help" %>

<p class="lead"><%= t("dashboard.lead") %></p>

<%# Only when there is something to do about it. A permanent panel saying
    "nothing expires soon" is a panel people stop reading. %>
<% if @mandates_due.any? %>
  <div class="warning">
    <strong><%= t("dashboard.mandates.title", count: @mandates_due.size) %></strong>
    <p><%= t("dashboard.mandates.body") %></p>
    <ul>
      <% @mandates_due.each do |passport| %>
        <li>
          <%= link_to passport.label, edit_passport_path(passport) %> —
          <% if passport.delegation_expired? %>
            <%= t("dashboard.mandates.expired") %>
          <% else %>
            <%= t("dashboard.mandates.until", date: l(passport.delegation_expires_at.in_time_zone, format: :short)) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<section class="cards">
  <%# What the operator has, on the left, because that is what they came for.
      Until the setup is finished there is nothing to have yet, and the honest
      thing to offer is the one step that has to come first. %>
  <div class="card wide">
    <% if !settings.setup_complete? %>
      <h2><%= t("dashboard.setup.title") %></h2>
      <p><%= t("dashboard.setup.body") %></p>
      <p><%= link_to t("dashboard.setup.action"), setup_path, class: "start" %></p>
    <% else %>
      <h2><%= t("dashboard.passports.title") %></h2>

      <% if @passports.any? %>
        <table class="compact">
          <tbody>
            <% @passports.each do |passport| %>
              <tr>
                <td><%= link_to passport.label, edit_passport_path(passport) %></td>
                <td class="when muted"><%= t("passports.states.#{passport.status}") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <p>
          <%= link_to t("dashboard.passports.all", count: @passport_count), passports_path %>
        </p>
      <% else %>
        <p class="muted"><%= t("dashboard.passports.none") %></p>
        <p><%= link_to t("nav.new_passport"), passports_path, class: "start" %></p>
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <h2><%= t("dashboard.state.title") %></h2>
    <dl>
      <dt><%= t("dashboard.state.file") %></dt>
      <dd><code><%= Vault::Store.path %></code></dd>
      <dt><%= t("dashboard.state.opened_at") %></dt>
      <dd><%= l(Vault::Session.opened_at.in_time_zone, format: :long) %></dd>
      <dt><%= t("dashboard.state.kdf_profile") %></dt>
      <dd><%= Vault::Session.profile %></dd>
    </dl>
  </div>
</section>

<section>
  <h2><%= t("dashboard.recent_events") %></h2>
  <% if @recent_events.any? %>
    <table>
      <tbody>
        <% @recent_events.each do |event| %>
          <tr>
            <td class="when"><%= l(event.occurred_at.in_time_zone, format: :short) %></td>
            <td><%= t("events.kinds.#{event.kind}") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p><%= link_to t("dashboard.all_events"), events_path %></p>
  <% else %>
    <p class="muted"><%= t("events.empty") %></p>
  <% end %>
</section>
