<%= form_with model: product_type, local: true do |f| %>
  <% if product_type.errors.any? %>
    <div class="flash alert">
      <ul>
        <% product_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend><%= t("product_types.form.legend") %></legend>

    <label for="product_type_label"><%= t("product_types.form.label") %></label>
    <%= f.text_field :label, autofocus: product_type.new_record? %>
    <p class="hint"><%= t("product_types.form.label_hint") %></p>

    <label for="product_type_structure_name"><%= t("product_types.form.structure") %></label>
    <%= f.text_field :structure_name %>
    <p class="hint"><%= t("product_types.form.structure_hint") %></p>

    <label for="product_type_repo_base_url"><%= t("product_types.form.repo") %></label>
    <%= f.text_field :repo_base_url %>
    <p class="hint"><%= t("product_types.form.repo_hint") %></p>

    <label for="product_type_transformation_name"><%= t("product_types.form.transformation") %></label>
    <%= f.text_field :transformation_name %>
    <p class="hint">
      <%= t("product_types.form.transformation_hint") %>
      <% if product_type.transformation? && !product_type.transformation_fetched? %>
        <strong><%= t("product_types.form.transformation_pending") %></strong>
      <% end %>
    </p>

    <label for="product_type_reverse_transformation_name"><%= t("product_types.form.reverse_transformation") %></label>
    <%= f.text_field :reverse_transformation_name %>
    <p class="hint">
      <%= t("product_types.form.reverse_transformation_hint") %>
      <% if product_type.reverse_transformation? && !product_type.reverse_transformation_fetched? %>
        <strong><%= t("product_types.form.reverse_transformation_pending") %></strong>
      <% end %>
    </p>

    <label for="product_type_form_tag"><%= t("product_types.form.tag") %></label>
    <%= f.text_field :form_tag %>
    <p class="hint">
      <%= t("product_types.form.tag_hint") %>
      <% offered = ProductType::LANGUAGES.flat_map { |language| product_type.form_tags_for(language) }.uniq %>
      <% if offered.any? %>
        <%= t("product_types.form.tag_offered", tags: offered.join(", ")) %>
      <% end %>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= t("product_types.form.legal.legend") %></legend>
    <p class="hint"><%= t("product_types.form.legal.lead") %></p>

    <label for="product_type_legal_act"><%= t("product_types.form.legal.legal_act") %></label>
    <%= f.text_field :legal_act %>
    <p class="hint"><%= t("product_types.form.legal.legal_act_hint") %></p>

    <label for="product_type_legal_act_url"><%= t("product_types.form.legal.legal_act_url") %></label>
    <%= f.url_field :legal_act_url %>
    <p class="hint"><%= t("product_types.form.legal.legal_act_url_hint") %></p>

    <label for="product_type_legal_act_valid_from"><%= t("product_types.form.legal.valid_from") %></label>
    <%= f.date_field :legal_act_valid_from %>
    <label for="product_type_legal_act_valid_until"><%= t("product_types.form.legal.valid_until") %></label>
    <%= f.date_field :legal_act_valid_until %>
    <p class="hint"><%= t("product_types.form.legal.valid_hint") %></p>

    <label for="product_type_dpp_required_from"><%= t("product_types.form.legal.required_from") %></label>
    <%= f.date_field :dpp_required_from %>
    <p class="hint"><%= t("product_types.form.legal.required_from_hint") %></p>

    <label for="product_type_granularity"><%= t("product_types.form.legal.granularity") %></label>
    <%= f.select :granularity,
          Dpp::ProductIdentifier::GRANULARITIES.map { |g| [ t("passports.granularities.#{g}"), g ] },
          { include_blank: true } %>
    <p class="hint"><%= t("product_types.form.legal.granularity_hint") %></p>

    <p><strong><%= t("product_types.form.legal.carriers") %></strong></p>
    <%= f.collection_check_boxes :carriers,
          ProductType::CARRIERS.map { |c| [ c, t("product_types.form.carrier_names.#{c}") ] }, :first, :last do |b| %>
      <%= b.label { b.check_box + " " + b.text } %>
    <% end %>

    <p><strong><%= t("product_types.form.legal.placement") %></strong></p>
    <%= f.collection_check_boxes :carrier_placement,
          ProductType::PLACEMENTS.map { |p| [ p, t("product_types.form.placement_names.#{p}") ] }, :first, :last do |b| %>
      <%= b.label { b.check_box + " " + b.text } %>
    <% end %>

    <label for="product_type_carrier_layout"><%= t("product_types.form.legal.layout") %></label>
    <%= f.text_area :carrier_layout, rows: 3 %>
    <p class="hint"><%= t("product_types.form.legal.layout_hint") %></p>

    <label for="product_type_availability_years"><%= t("product_types.form.legal.availability") %></label>
    <%= f.number_field :availability_years, min: 1, max: 100, step: 1 %>
    <p class="hint"><%= t("product_types.form.legal.availability_hint") %></p>
  </fieldset>

  <%= f.submit t("product_types.form.save") %>
<% end %>

<p><%= link_to t("product_types.back"), product_types_path %></p>
