<%= form_with model: product_type, local: true do |f| %>
  <% if product_type.errors.any? %>
    <div class="flash alert">
      <ul>
        <% product_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend><%= t("product_types.form.legend") %></legend>

    <label for="product_type_label"><%= t("product_types.form.label") %></label>
    <%= f.text_field :label, autofocus: product_type.new_record? %>
    <p class="hint"><%= t("product_types.form.label_hint") %></p>

    <label for="product_type_structure_name"><%= t("product_types.form.structure") %></label>
    <%= f.text_field :structure_name %>
    <p class="hint"><%= t("product_types.form.structure_hint") %></p>

    <label for="product_type_repo_base_url"><%= t("product_types.form.repo") %></label>
    <%= f.text_field :repo_base_url %>
    <p class="hint"><%= t("product_types.form.repo_hint") %></p>

    <label for="product_type_transformation_name"><%= t("product_types.form.transformation") %></label>
    <%= f.text_field :transformation_name %>
    <p class="hint">
      <%= t("product_types.form.transformation_hint") %>
      <% if product_type.transformation? && !product_type.transformation_fetched? %>
        <strong><%= t("product_types.form.transformation_pending") %></strong>
      <% end %>
    </p>

    <label for="product_type_reverse_transformation_name"><%= t("product_types.form.reverse_transformation") %></label>
    <%= f.text_field :reverse_transformation_name %>
    <p class="hint">
      <%= t("product_types.form.reverse_transformation_hint") %>
      <% if product_type.reverse_transformation? && !product_type.reverse_transformation_fetched? %>
        <strong><%= t("product_types.form.reverse_transformation_pending") %></strong>
      <% end %>
    </p>

    <label for="product_type_form_tag"><%= t("product_types.form.tag") %></label>
    <%= f.text_field :form_tag %>
    <p class="hint">
      <%= t("product_types.form.tag_hint") %>
      <% offered = ProductType::LANGUAGES.flat_map { |language| product_type.form_tags_for(language) }.uniq %>
      <% if offered.any? %>
        <%= t("product_types.form.tag_offered", tags: offered.join(", ")) %>
      <% end %>
    </p>
  </fieldset>

  <%= f.submit t("product_types.form.save") %>
<% end %>

<p><%= link_to t("product_types.back"), product_types_path %></p>
