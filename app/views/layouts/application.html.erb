<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <%# resume: what was typed into a form survives a lock that interrupted it.
      confirm: the application's own confirmation step instead of window.confirm. %>
  <body data-controller="resume confirm"
        <% if flash[:resume_action].present? %>data-resume-restore-value="<%= flash[:resume_action] %>"<% end %>>
    <%# The bar spans the window so the page has a lid, but everything in it
        sits in a block as wide as `main` — otherwise the navigation starts at
        the window edge while the content it belongs to starts a quarter of the
        way in, and the two look like different pages. %>
    <header class="bar">
      <div class="bar-inner">
        <%# The title leads home, and Overview stays as its own entry: that a
            wordmark is a link is a convention not everybody knows, and the
            entry costs one slot. %>
        <%= link_to root_path, class: "brand" do %>
          <%= image_tag "oyd-mark.svg", class: "mark", alt: "" %>
          <%= t("app.name") %>
        <% end %>

        <%# Three groups rather than eight equals: making passports, being
            somebody, and looking after this installation's own data. %>
        <nav data-controller="nav-menu">
          <%= link_to t("nav.dashboard"), root_path, class: ("on" if current_page?(root_path)) %>

          <details class="menu <%= "on" if nav_section?(passports_path, lookup_path, product_types_path, access_grants_path) %>"
                   data-nav-menu-target="menu" data-action="toggle->nav-menu#opened">
            <summary><%= t("nav.groups.passports") %></summary>
            <div>
              <%= link_to t("nav.all_passports"), passports_path, class: ("on" if current_page?(passports_path)) %>
              <%= link_to t("nav.read_passport"), lookup_path, class: ("on" if current_page?(lookup_path)) %>
              <div class="sep"></div>
              <%= link_to t("nav.product_types"), product_types_path, class: ("on" if current_page?(product_types_path)) %>
              <%= link_to t("nav.access_grants"), access_grants_path, class: ("on" if current_page?(access_grants_path)) %>
            </div>
          </details>

          <details class="menu <%= "on" if nav_section?(identity_path, setup_path) %>"
                   data-nav-menu-target="menu" data-action="toggle->nav-menu#opened">
            <summary><%= t("nav.groups.identity") %></summary>
            <div>
              <%= link_to t("nav.identity"), identity_path, class: ("on" if current_page?(identity_path)) if Identity.current %>
              <%= link_to t("nav.setup"), setup_path, class: ("on" if current_page?(setup_path)) %>
            </div>
          </details>

          <details class="menu <%= "on" if nav_section?(vault_path, events_path, settings_path) %>"
                   data-nav-menu-target="menu" data-action="toggle->nav-menu#opened">
            <summary><%= t("nav.groups.administration") %></summary>
            <div>
              <%= link_to t("nav.vault"), vault_path, class: ("on" if current_page?(vault_path)) %>
              <%= link_to t("nav.events"), events_path, class: ("on" if current_page?(events_path)) %>
              <div class="sep"></div>
              <%= link_to t("nav.settings"), settings_path, class: ("on" if current_page?(settings_path)) %>
            </div>
          </details>

          <%# On the right, as in the bars of the DPP Linter and the Validator: the
              DPP Service this installation submits to. It is the one link in
              the bar that leaves the application, so it opens in a tab of its
              own — an open vault should not navigate away from itself. On a
              narrow window it ends the row of the navigation. %>
          <%= link_to t("nav.dpp_service"), dpp_service_url, class: "service", title: dpp_service_url,
                      target: "_blank", rel: "noopener" %>
        </nav>

        <%= button_to lock_path, method: :delete, class: "link" do %>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="2.6" y="7" width="10.8" height="7.4" rx="1.6"/>
            <path d="M5.2 7V4.8a2.8 2.8 0 0 1 5.6 0V7"/>
          </svg>
          <%= t("nav.lock") %>
        <% end %>
      </div>
    </header>

    <main>
      <%# The problems belong inside the message that announced them — a count on
          its own tells somebody that something is wrong and nothing about what.
          Folded shut, because most of the time the sentence above is the whole
          answer, and a list of constraint violations under every save reads as
          an error report to somebody who only wanted to keep a draft. %>
      <% if notice %>
        <div class="flash notice">
          <p><%= notice %></p>
          <% if flash[:problems].present? %>
            <details class="problems">
              <summary><%= t("passports.problem.show", count: flash[:problem_count] || Array(flash[:problems]).size) %></summary>
              <ul>
                <% Array(flash[:problems]).each do |problem| %><li><%= problem %></li><% end %>
              </ul>
            </details>
          <% end %>
        </div>
      <% end %>
      <% if alert %>
        <div class="flash alert">
          <p><%= alert %></p>
          <%= render "shared/reader_missing", missing: flash[:reader_missing] if flash[:reader_missing].present? %>
          <% if flash[:problems].present? %>
            <details class="problems" open>
              <summary><%= t("passports.problem.show", count: flash[:problem_count] || Array(flash[:problems]).size) %></summary>
              <ul>
                <% Array(flash[:problems]).each do |problem| %><li><%= problem %></li><% end %>
              </ul>
            </details>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer>
      <%# Like the footers of the DPP Service and the DPP Linter: who made it,
          where the rest of the DPP tools are, the source and the version. The
          links are quiet on purpose: in the same grey as the sentence around
          them, underlined only under the cursor. A blue link in the footer
          would pull the eye away from whatever the page is actually for.
          The words that name the file lead to the page about it; every other
          link leads out to the web and opens a new tab — an application holding
          an open vault should not navigate away from itself because somebody
          read the footer. %>
      <p class="by">
        <%= image_tag "oyd-mark.svg", class: "mark", alt: "" %>
        <span><%= t("app.footer_html",
                    home: link_to(t("app.footer_home"), t("app.footer_home_url"),
                                  class: "quiet", target: "_blank", rel: "noopener"),
                    link: (vault_open? ? link_to(t("app.footer_link"), vault_path, class: "quiet")
                                       : t("app.footer_link"))) %></span>
      </p>
      <%# The separator stays with the item before it, so that a narrow window
          breaks the line after a dot and never starts one with it. %>
      <p class="links">
        <%= link_to t("app.footer_tools"), Setting::DEFAULT_SERVICE_BASE_URL,
                    class: "quiet", target: "_blank", rel: "noopener" %>&nbsp;·
        <%= link_to t("app.footer_source"), "https://github.com/OwnYourData/dpp-manager-public",
                    class: "quiet", target: "_blank", rel: "noopener" %>&nbsp;·
        <%= t("app.footer_version", version: DppManager::VERSION) %>
      </p>
      <p class="funding" lang="en"><%= funding_notice %></p>
    </footer>

    <dialog class="confirm-step" data-confirm-target="dialog"
            aria-labelledby="confirm-step-title" aria-describedby="confirm-step-message">
      <h2 id="confirm-step-title"><%= t("confirm_step.title") %></h2>
      <p id="confirm-step-message" data-confirm-target="message"></p>
      <div class="actions">
        <button type="button" class="secondary" data-confirm-target="cancel"><%= t("confirm_step.cancel") %></button>
        <button type="button" data-confirm-target="accept"><%= t("confirm_step.accept") %></button>
      </div>
    </dialog>
  </body>
</html>
