<h1><%= t("passports.access_policy.details_title") %></h1>
<p class="lead"><%= @passport.label %> · <code class="break"><%= @passport.access_policy_id %></code></p>

<%# The two lists behind the counts, as the service sees the passport it holds.
    Neither is an error: an empty optional field leaves a rule with nothing to
    reach, and an attribute no rule reaches is kept for authorities. %>
<h2><%= t("passports.access_policy.unclassified_title") %></h2>
<p class="hint"><%= t("passports.access_policy.unclassified_hint") %></p>
<% unclassified = Array(@details["unclassified"]) %>
<% if unclassified.any? %>
  <ul><% unclassified.each do |path| %><li><code><%= path %></code></li><% end %></ul>
<% else %>
  <p class="muted"><%= t("passports.access_policy.none_listed") %></p>
<% end %>

<h2><%= t("passports.access_policy.unused_title") %></h2>
<p class="hint"><%= t("passports.access_policy.unused_hint") %></p>
<% unused = Array(@details["unusedRules"]) %>
<% if unused.any? %>
  <ul><% unused.each do |path| %><li><code><%= path %></code></li><% end %></ul>
<% else %>
  <p class="muted"><%= t("passports.access_policy.none_listed") %></p>
<% end %>

<p><%= link_to t("passports.access_policy.back"), edit_passport_path(@passport) %></p>
